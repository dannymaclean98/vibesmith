// Prisma schema for VibeSmiths Playlist Display

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authenticated user - someone who has verified their phone number
model User {
  id          String   @id @default(uuid())
  phone       String   @unique // Verified phone number (e.g., "12149014824")
  displayName String?  // User-chosen display name
  avatarUrl   String?  // URL to avatar (points to /api/avatar/[id] when stored in DB)
  avatarData  Bytes?   // Avatar image binary data
  avatarMime  String?  // MIME type (e.g., "image/png")
  
  // Link to their Member record (from iMessage data)
  memberId    String?  @unique
  member      Member?  @relation(fields: [memberId], references: [id])
  
  // Session management
  sessions    Session[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Session for authenticated users
model Session {
  id        String   @id @default(uuid())
  token     String   @unique @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([token])
  @@index([userId])
}

// Pending verification codes
model VerificationCode {
  id        String   @id @default(uuid())
  phone     String
  code      String   // 6-digit code
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  
  @@index([phone])
}

// Represents a member of the group chat (from iMessage export)
model Member {
  id        String   @id @default(uuid())
  name      String   // Display name from iMessage or user-set
  phone     String?  @unique // iMessage identifier (phone number)
  avatarUrl String?
  color     String?  // Assigned color for UI display
  
  // Link to authenticated user (if they've claimed this profile)
  user      User?
  
  sentTracks   Track[]    @relation("TrackSender")
  reactions    Reaction[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A track shared in the group chat
model Track {
  id              String   @id @default(uuid())
  
  // Spotify/Music metadata
  spotifyTrackId  String?
  spotifyUrl      String?
  trackName       String
  artistName      String
  albumName       String?
  albumImageUrl   String?
  previewUrl      String?
  
  // Who sent it and when
  senderId        String
  sender          Member   @relation("TrackSender", fields: [senderId], references: [id], onDelete: Cascade)
  sentAt          DateTime
  
  // iMessage data
  messageId       String?  @unique // Original iMessage ID for deduplication
  
  reactions       Reaction[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([senderId])
  @@index([sentAt])
}

// Emoji reactions on tracks
model Reaction {
  id        String   @id @default(uuid())
  emoji     String   // The emoji or sticker
  
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  reactedAt DateTime @default(now())
  
  @@unique([trackId, memberId, emoji]) // One reaction type per person per track
  @@index([trackId])
  @@index([memberId])
}
